---
import { Badge } from "@/components/ui/badge";
import { Button } from "@/components/ui/button";
import {
  Card,
  CardContent,
  CardDescription,
  CardFooter,
  CardHeader,
  CardTitle,
} from "@/components/ui/card";

const products = [
  {
    name: "The Single",
    pairs: "1 pair",
    price: "$14",
    note: "Try the ritual once.",
    tone: "from-[#b39c87] via-[#6b4a35] to-[#1c1612]",
  },
  {
    name: "The Week",
    pairs: "7 pairs",
    price: "$78",
    note: "Our most loved. A full reset.",
    tone: "from-[#f0a066] via-[#c2552c] to-[#3a140c]",
    badge: "Bestseller",
  },
  {
    name: "The Ritual",
    pairs: "8 pairs / month",
    price: "$84",
    note: "Twice weekly, delivered. Pause anytime.",
    tone: "from-[#8a7360] via-[#5e1a10] to-[#14100d]",
    badge: "Subscribe",
  },
];
---

<section id="shop" class="mx-auto max-w-[90rem] px-5 py-28 sm:px-8 md:py-40">
  <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
    <h2
      class="text-6xl leading-[0.88] font-extralight tracking-[-0.045em] uppercase md:text-[9rem]"
      data-split="chars"
    >
      Shop
    </h2>
    <p class="max-w-sm text-lg text-peach/70" data-reveal>
      Single-use, biodegradable cotton gloves soaked in 18ml of peptide serum.
    </p>
  </div>

  <div
    class="mt-14 grid gap-5 md:mt-20 md:grid-cols-3 md:gap-6"
    data-reveal-group
  >
    {products.map((p) => (
      <Card className="group gap-0 overflow-hidden rounded-[2rem] border-peach/12 bg-ink-2 py-0 ring-0">
        <div
          class={`grain relative aspect-[4/5] overflow-hidden bg-gradient-to-br ${p.tone}`}
        >
          <div class="absolute inset-0 transition-transform duration-[1.2s] ease-[var(--ease-out-expo)] group-hover:scale-105" />
          <span class="absolute inset-x-0 bottom-6 text-center text-[5rem] font-extralight tracking-[-0.06em] text-peach/85 mix-blend-soft-light md:text-[6rem]">
            손
          </span>
          {p.badge && (
            <Badge className="absolute top-5 left-5 rounded-full bg-peach px-3 py-1 text-sand-ink">
              {p.badge}
            </Badge>
          )}
        </div>
        <CardHeader className="px-6 pt-6">
          <div class="flex items-baseline justify-between gap-4">
            <CardTitle className="text-2xl font-light tracking-[-0.03em] md:text-3xl">
              {p.name}
            </CardTitle>
            <span class="text-xl font-light tabular-nums">{p.price}</span>
          </div>
          <CardDescription className="text-peach/60">
            {p.pairs} · {p.note}
          </CardDescription>
        </CardHeader>
        <CardContent className="px-6" />
        <CardFooter className="border-0 bg-transparent px-6 pt-6 pb-6">
          <Button
            className="h-12 w-full rounded-full text-base"
            variant="default"
          >
            Add to cart
          </Button>
        </CardFooter>
      </Card>
    ))}
  </div>
</section>
