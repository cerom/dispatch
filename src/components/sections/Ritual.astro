---
import { Badge } from "@/components/ui/badge";
import { Separator } from "@/components/ui/separator";

const steps = [
  {
    time: "1 min",
    title: "Wash",
    body: "Lukewarm water, a gentle cleanser. Pat dry, leave them slightly damp.",
  },
  {
    time: "20 min",
    title: "Slip on",
    body: "Open the pouch, slide in each hand, press the cuffs closed. Sit. Do nothing.",
  },
  {
    time: "2 min",
    title: "Press in",
    body: "Remove the gloves and massage what's left into knuckles, cuticles and wrists.",
  },
];
---

<section id="ritual" class="mx-auto max-w-[90rem] px-5 py-28 sm:px-8 md:py-44">
  <div class="flex flex-col gap-8 md:flex-row md:items-end md:justify-between">
    <div>
      <div data-reveal>
        <Badge
          variant="outline"
          className="rounded-full border-peach/25 px-3 py-1 text-peach/80"
        >
          03 — Ritual
        </Badge>
      </div>
      <h2
        class="mt-6 text-6xl leading-[0.88] font-extralight tracking-[-0.045em] uppercase md:text-[9rem]"
        data-split="chars"
      >
        <span class="block">Twenty</span>
        <span class="block">minutes</span>
      </h2>
    </div>
    <p class="max-w-sm text-lg text-peach/70" data-reveal data-delay="0.2">
      Twice a week. Long enough to finish an episode, short enough that you'll
      actually do it.
    </p>
  </div>

  <Separator className="my-14 bg-peach/12 md:my-20" />

  <ol class="grid gap-12 md:grid-cols-3 md:gap-8" data-reveal-group>
    {steps.map((s, i) => (
      <li class="flex flex-col gap-5">
        <div class="flex items-baseline justify-between text-sm text-peach/55">
          <span class="tabular-nums">{String(i + 1).padStart(2, "0")}</span>
          <span>{s.time}</span>
        </div>
        <h3 class="text-4xl font-extralight tracking-[-0.04em] md:text-5xl">
          {s.title}
        </h3>
        <p class="max-w-[32ch] leading-relaxed text-peach/70">{s.body}</p>
      </li>
    ))}
  </ol>
</section>
