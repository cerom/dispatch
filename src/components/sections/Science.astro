---
const actives = [
  {
    name: "Copper tripeptide",
    inci: "GHK-Cu",
    body: "A signalling peptide studied for its role in skin's own repair cycle. Here for firmness and bounce.",
    tone: "from-[#c2552c] to-[#5e1a10]",
  },
  {
    name: "Palmitoyl pentapeptide",
    inci: "Pal-KTTKS",
    body: "A collagen-supporting peptide that helps smooth the fine crêpe that shows on the back of the hand.",
    tone: "from-[#b39c87] to-[#3a2a1f]",
  },
  {
    name: "Ceramide complex",
    inci: "NP · AP · EOP",
    body: "Rebuilds the lipid barrier that frequent washing strips away, so moisture stays where you put it.",
    tone: "from-[#f0a066] to-[#7a1d12]",
  },
  {
    name: "Niacinamide",
    inci: "Vitamin B3",
    body: "Evens tone and softens the look of sun spots over weeks of consistent use.",
    tone: "from-[#8a7360] to-[#1c1612]",
  },
];
---

<section id="science" data-pin class="relative">
  <div class="sticky top-0 flex h-svh flex-col overflow-hidden">
    <div class="flex items-end justify-between gap-6 px-5 pt-24 sm:px-8 md:px-[3.25%] md:pt-32">
      <div>
        <p class="mb-5 text-sm text-peach/60" data-reveal>
          02 — Science
        </p>
        <h2
          class="max-w-[14ch] text-5xl leading-[0.9] font-extralight tracking-[-0.045em] uppercase md:text-8xl"
          data-split="chars"
        >
          The science
        </h2>
      </div>
      <p
        class="shrink-0 font-light text-peach/60 tabular-nums"
        aria-hidden="true"
      >
        <span data-pin-counter>01</span> /{" "}
        {String(actives.length).padStart(2, "0")}
      </p>
    </div>

    <div class="relative mt-10 flex-1 md:mt-14">
      <div
        data-pin-track
        class="flex h-full w-max gap-4 px-5 pb-10 will-change-transform sm:px-8 md:gap-6 md:px-[3.25%] md:pb-14"
      >
        {actives.map((a, i) => (
          <article class="relative flex h-full w-[82vw] shrink-0 flex-col justify-between overflow-hidden rounded-[2rem] border border-peach/12 bg-ink-2 p-6 sm:w-[64vw] md:w-[48vw] md:rounded-[2.75rem] md:p-10 lg:w-[40vw]">
            <div
              aria-hidden="true"
              class={`grain absolute -top-1/3 -right-1/3 size-[90%] rounded-full bg-gradient-to-br opacity-70 blur-3xl ${a.tone}`}
            />
            <div class="relative flex items-center justify-between text-sm text-peach/60">
              <span>{String(i + 1).padStart(2, "0")}</span>
              <span>{a.inci}</span>
            </div>
            <div class="relative">
              <h3 class="text-4xl leading-[0.95] font-extralight tracking-[-0.04em] md:text-6xl">
                {a.name}
              </h3>
              <p class="mt-5 max-w-[34ch] text-base leading-relaxed text-peach/70 md:text-lg">
                {a.body}
              </p>
            </div>
          </article>
        ))}
      </div>
    </div>

    <div class="absolute inset-x-5 bottom-4 h-px bg-peach/10 sm:inset-x-8 md:inset-x-[3.25%] md:bottom-6">
      <div
        data-pin-progress
        class="h-full origin-left scale-x-0 bg-peach/70"
      ></div>
    </div>
  </div>
</section>
